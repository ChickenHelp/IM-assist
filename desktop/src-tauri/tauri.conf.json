{
  "$schema": "https://raw.githubusercontent.com/nicedoc/static/main/tauri/2.x/tauri.conf.json",
  "productName": "PitWall",
  "version": "0.1.0",
  "identifier": "com.pitwall.app",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../../frontend && npm run dev",
    "beforeBuildCommand": "cd ../../frontend && npm run build"
  },
  "app": {
    "title": "PitWall — Race Engineer",
    "windows": [
      {
        "title": "PitWall",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ]
  }
}
